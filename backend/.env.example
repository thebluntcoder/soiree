# Copy to backend/.env and fill in. See app/core/config.py for the full
# Settings class — every var here maps 1:1 to a field there.

# App
APP_ENV=development
# Any strong random string in production — the app refuses to boot in
# APP_ENV=production while this is still the default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database (docker-compose's db service, or your own Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/soiree

# Redis (docker-compose's redis service)
REDIS_URL=redis://localhost:6379/0

# Anthropic — required for plan generation
ANTHROPIC_API_KEY=

# Swiggy OAuth redirect — must be whitelisted with Swiggy.
# Local dev: http://localhost/auth/callback (frontend on port 80 — see
# docs/deployment.md's "Swiggy OAuth redirect URIs" section)
REDIRECT_URI=http://localhost/auth/callback

# Swiggy MCP — optional locally; omitted, every MCP call falls back to
# mock data of the same shape (see services/mcp/base.py)
SWIGGY_API_KEY=
SWIGGY_MCP_FOOD_URL=
SWIGGY_MCP_INSTAMART_URL=
SWIGGY_MCP_DINEOUT_URL=

# Analytics — optional. Unset = PostHog fully off, no client built, no
# network call (see services/analytics.py)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Error tracking — optional. Unset = Sentry never initialised (see main.py)
SENTRY_DSN=
